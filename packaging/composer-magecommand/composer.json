{
    "name": "cresset/magecommand",
    "description": "Build a Magento 2 codebase without PHP: setup:di:compile and setup:static-content:deploy, reimplemented in Rust. Fetches the prebuilt binary on demand.",
    "type": "library",
    "license": "EUPL-1.2",
    "keywords": ["magento", "magento2", "cli", "build", "di-compile", "static-content-deploy"],
    "homepage": "https://github.com/cresset-tools/magequery",
    "authors": [
        { "name": "Jelle Besseling", "email": "jelle@pingiun.com" }
    ],
    "require": {
        "php": ">=8.1"
    },
    "suggest": {
        "ext-curl": "Faster, more reliable binary downloads",
        "ext-zip": "Required to install on Windows (the binary ships as a .zip)"
    },
    "bin": ["bin/magecommand"],
    "extra": {
        "bougie": {
            "default-bin": "bin/magecommand",
            "native-binary": {
                "spec": 1,
                "name": "magequery",
                "bin": "magecommand",
                "tag-prefix": "magequery-v",
                "base-urls": [
                    "https://releases.bougie.tools/github/magequery/releases/download",
                    "https://github.com/cresset-tools/magequery/releases/download"
                ],
                "targets": [
                    "x86_64-unknown-linux-gnu",
                    "x86_64-unknown-linux-musl",
                    "aarch64-apple-darwin",
                    "x86_64-pc-windows-msvc"
                ],
                "sigstore": {
                    "repository": "cresset-tools/magequery"
                }
            }
        }
    }
}
