#!/usr/bin/env php
<?php

declare(strict_types=1);

// Composer `bin` entry for cresset/magecommand. magecommand is a Rust binary;
// this package ships only this thin launcher, which fetches the matching
// prebuilt `magecommand` for the current platform on first use, caches it,
// and execs it. src/Launcher.php is copied in from packaging/composer/ when
// the package is published, so both packages share one launcher.

namespace Cresset\Magequery;

require __DIR__ . '/../src/Launcher.php';

exit(Launcher::main(array_slice($argv, 1), 'magecommand'));
