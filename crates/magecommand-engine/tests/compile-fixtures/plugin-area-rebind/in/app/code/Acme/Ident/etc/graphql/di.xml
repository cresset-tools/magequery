<?xml version="1.0"?>
<!-- The same plugin NAME rebound to another class in one area, as GraphQlCache
     does with core-app-area-design-exception-plugin: graphql must call Graph,
     every other area Storefront. -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Acme\Ident\Model\Identifier">
        <plugin name="acme_identifier" type="Acme\Ident\Plugin\Graph"/>
    </type>
</config>
